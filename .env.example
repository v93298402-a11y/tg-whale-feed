# Telegram Bot used to post whale-sales to the destination channel.
# Create a bot via @BotFather, then add it as an admin of your channel.
WHALE_BOT_TOKEN=

# Destination channel (e.g. @tggifts100plus or -1001234567890).
WHALE_CHANNEL=

# Optional: minimum TON price to count as a whale. Default 100.0.
# WHALE_THRESHOLD_TON=100.0

# --- Telegram API credentials for the Telethon scrapers ---
# These default to public Telegram Desktop credentials (no signup needed).
# Override only if you have your own.
# API_ID=2040
# API_HASH=b18441a1ff607e10a989891a5462e627

# Telethon session file basename (default: whale_feed -> whale_feed.session)
# SESSION_NAME=whale_feed

# --- Source toggles ---
# Set to 0 to disable a particular source. Default = enabled.
# WHALE_FRAGMENT_ENABLED=1
# WHALE_MRKT_ENABLED=1
# WHALE_PORTALS_ENABLED=1
# WHALE_TONNEL_ENABLED=1

# --- Optional: Getgems API key ---
# Required only for the Getgems source. Without it, Getgems is silently disabled.
# GETGEMS_API_KEY=
